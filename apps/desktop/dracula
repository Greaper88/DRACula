#!/bin/sh
# Copyright 2026 DRACula contributors
# SPDX-License-Identifier: Apache-2.0
set -eu
DRACULA_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
for DRACULA_COMMAND in java python3 curl; do
  command -v "$DRACULA_COMMAND" >/dev/null || { printf 'Required tool missing: %s (see apps/desktop/README.md)\n' "$DRACULA_COMMAND" >&2; exit 1; }
done
python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3,12) else "Python 3.12 or newer is required")'
DRACULA_BUILD_NEEDED=0
if [ ! -f "$DRACULA_ROOT/.local/desktop/dracula-manager.jar" ]; then
  DRACULA_BUILD_NEEDED=1
else
  for DRACULA_SOURCE in "$DRACULA_ROOT"/apps/desktop/java/dracula/*.java "$DRACULA_ROOT/apps/desktop/build.sh" "$DRACULA_ROOT/LICENSE" "$DRACULA_ROOT/NOTICE" "$DRACULA_ROOT/THIRD_PARTY_NOTICES.md"; do
    if [ "$DRACULA_SOURCE" -nt "$DRACULA_ROOT/.local/desktop/dracula-manager.jar" ]; then DRACULA_BUILD_NEEDED=1; fi
  done
fi
if [ "$DRACULA_BUILD_NEEDED" -eq 1 ]; then "$DRACULA_ROOT/apps/desktop/build.sh"; fi
exec java -Ddracula.root="$DRACULA_ROOT" -Djava.util.prefs.userRoot="$DRACULA_ROOT/.local/preferences" -jar "$DRACULA_ROOT/.local/desktop/dracula-manager.jar"
